            ],
            "url": { "raw": "{{base_url}}/blog/1", "host": ["{{base_url}}"], "path": ["blog", "1"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Как выбрать пряник в подарок (обновлено)\",\n  \"preview_text\": \"Обновлённые советы по выбору пряника\"\n}"
            }
          }
        },
        {
          "name": "Delete Post (admin)",
          "request": {
