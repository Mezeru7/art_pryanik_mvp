              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/blog/1", "host": ["{{base_url}}"], "path": ["blog", "1"] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "description": "Управление заказами",
      "item": [
        {
          "name": "Get All Orders (admin)",
          "request": {
