            ],
            "url": { "raw": "{{base_url}}/blog", "host": ["{{base_url}}"], "path": ["blog"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Как выбрать пряник в подарок\",\n  \"preview_text\": \"Советы по выбору идеального пряника для любого праздника\",\n  \"content\": \"Полный текст статьи о выборе пряников...\",\n  \"image_url\": \"/assets/images/blog_first.png\"\n}"
            }
